datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  userName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id            String   @id @default(cuid())
  articleName   String
  articleContent String
  createdBy     String?
  creationDate  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PdfFile {
  id         String   @id @default(cuid())
  fileId     String   @unique
  storageId  String
  fileName   String
  fileUrl    String
  createdBy  String?
  createdAt  DateTime @default(now())
}
